# Arquivo de RESPOSTAS de exemplo para:  sudo bash baseline.sh --respostas respostas.env
# O que estiver aqui não é perguntado; o que faltar, o script pergunta. Senhas do SNMP NUNCA vão aqui
# (são sempre digitadas). O /root/baseline.env de um servidor pronto serve de modelo para o próximo:
# copie, troque HOSTNAME_ e V6, e use com --respostas.
# Os endereços abaixo são de DOCUMENTAÇÃO (RFC 5737 / RFC 3849) e o script os RECUSA de propósito: troque pelos seus.
# Listas (GESTAO_SSH, SNMP_ORIGENS): vários IPs/redes separados por espaço.

TZ_="America/Sao_Paulo"
HOSTNAME_="web01"
ATUALIZAR_AGORA="sim"
HORA="07:00"
# Num servidor DNS: ATUALIZA_SEGURAR="unbound"
ATUALIZA_SEGURAR=""

V6_ATIVAR="sim"
V6_BLOCO="2001:db8::/32"
V6_PREFIXO="2001:db8:100:1::/64"
V6="2001:db8:100:1::10"
V6_GW="2001:db8:100:1::1"

ADMIN_USER="admin"
PUBKEY="ssh-ed25519 AAAA...cole-a-sua-chave-publica... usuario@notebook"
SSH_PORT="44320"
GESTAO_SSH="192.0.2.10 198.51.100.0/24"
# Endurecimento do SSH (v2.1.0). SSH_USUARIOS: só estes entram por SSH (o ADMIN_USER é obrigatório); vários, separados por espaço.
# Contas de serviço que usam SSH (backup, rsync…) precisam estar na lista. Padrões seguros: encaminhamento desligado.
SSH_USUARIOS="admin"
SSH_TCP_FWD="nao"
SSH_AGENT_FWD="nao"
SSH_GRACE="30"
SSH_ALIVE_INT="300"
SSH_ALIVE_MAX="2"

SNMP="sim"
SNMP_ORIGENS="192.0.2.51"
SNMP_USER="monitorv3"
SNMP_LOCATION="Datacenter_Central"
SNMP_CONTACT="suporte@exemplo.com.br"
